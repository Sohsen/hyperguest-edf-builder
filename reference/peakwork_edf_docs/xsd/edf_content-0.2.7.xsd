			<xs:enumeration value="NATIONAL_IDENTIFICATION_CODE">
				<xs:annotation>
					<xs:documentation>
					An accommodation's nationally assigned identification code. e.g. CIN in Italy.
					</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
